node_modules/

# Local Claude Code permission cache — machine-specific, can contain the ntfy
# topic name from allowed command history.
.claude/settings.local.json

# Credentials — never commit these.
.env

# Run state: what each size looked like on the previous check.
.watch-state.json
.watch-state/

# The dashboard's watchlist — what you're watching is a personal, editable
# local file, not something to check in (the seeded default is generated on
# first run, from the same defaults the CLI uses).
watchlist.json

# Saved pages from --dump
*.dump.html
