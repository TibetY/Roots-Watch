# React Router / Vite
/.react-router/
/build/

# Credentials — never commit these. The Settings screen writes here.
.env

# Your watchlist and what the watcher last saw. Personal, machine-local state.
/data/

# Local Claude Code permission cache — machine-specific, can contain the ntfy
# topic name from allowed command history.
.claude/settings.local.json

.DS_Store

# Emitted by @netlify/vite-plugin-react-router at build time — the SSR
# function Netlify picks up. Rebuilt every deploy; never committed.
/.netlify/
