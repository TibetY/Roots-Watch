# Copy to .env and fill in. .env is gitignored; keep it that way.
#
# Only the first three are needed to boot. Alert settings (ntfy/webhook,
# check interval, timezone) live in the database now, edited from the Settings
# screen — they used to be written back into this file, which stops working on
# a host with a read-only filesystem.

# --- Supabase --------------------------------------------------------------
# Project Settings -> Data API. The URL and anon key are public by design: the
# anon key ships to the browser and is fenced in by row level security.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=

# Project Settings -> API keys -> service_role. This one bypasses row level
# security entirely. It is read only by the scheduled sweep. Never expose it to
# a browser, never commit it, and do not add it to any variable name a bundler
# might inline.
SUPABASE_SERVICE_ROLE_KEY=

# --- Who may sign in -------------------------------------------------------
# Comma-separated Google account addresses. An empty or missing value refuses
# everyone rather than defaulting open — a misconfiguration should fail shut.
#
# Sign-in is Google OAuth, so anyone with a Google account can get as far as
# Supabase issuing them a session. This list is what decides whether that
# session is any use: it is checked when they come back from Google, and again
# on every request afterwards, and a session belonging to an address not on it
# is torn down rather than merely ignored.
ALLOWED_EMAILS=you@example.com

# --- Server ----------------------------------------------------------------
# Port for `npm start` when running the Node server directly. Defaults to 3000.
# Netlify sets its own; leave unset there.
# PORT=3000
