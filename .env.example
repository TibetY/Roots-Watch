# Copy to .env and fill in — or just use the Settings screen, which writes
# these two keys here for you. .env is gitignored; keep it that way, these are
# credentials.

# --- Notifications ---------------------------------------------------------
# Any JSON webhook — ntfy, Pushover, Slack, Discord, an IFTTT/Zapier hook wired
# to SMS.
#
# For Slack/Discord/Pushover, ROOTS_WATCH_WEBHOOK is the full webhook URL and
# ROOTS_WATCH_WEBHOOK_TOPIC is unused.
#
# For ntfy.sh, set ROOTS_WATCH_WEBHOOK to the bare origin and put the topic in
# ROOTS_WATCH_WEBHOOK_TOPIC — ntfy only parses JSON fields when you POST to its
# origin with `topic` in the body, not when posting straight to /<topic>.
#
# Pick a long, random topic name: ntfy topics are public and unauthenticated,
# so anyone who knows the name can read or publish to it.
# ROOTS_WATCH_WEBHOOK=https://ntfy.sh
# ROOTS_WATCH_WEBHOOK_TOPIC=

# --- Server ----------------------------------------------------------------
# Port for `npm start` (the production server). Defaults to 3000.
# PORT=3000
