# Copy to .env and fill in. .env is gitignored — keep it that way, these are
# credentials. On GitHub Actions these live in repository secrets instead.

# --- Notifications ---------------------------------------------------------
# Any JSON webhook — Pushover, ntfy, Slack, Discord, an IFTTT/Zapier hook wired
# to SMS.
# For Slack/Discord/Pushover, ROOTS_WATCH_WEBHOOK is the full webhook URL and
# ROOTS_WATCH_WEBHOOK_TOPIC is unused.
# For ntfy.sh, set ROOTS_WATCH_WEBHOOK to the bare origin and put the topic in
# ROOTS_WATCH_WEBHOOK_TOPIC — ntfy only parses JSON fields when you POST to
# its origin with `topic` in the body, not when posting straight to /<topic>.
# Pick a long, random topic name: ntfy topics are public and unauthenticated,
# so anyone who knows the name can read or publish to it.
# ROOTS_WATCH_WEBHOOK=https://ntfy.sh
# ROOTS_WATCH_WEBHOOK_TOPIC=

# --- What to watch (all optional; defaults are the Big Apple tee) ----------
# Only used by the single-item CLI (src/index.mjs) — the dashboard (npm run
# ui) keeps its watchlist in watchlist.json instead, see the README.
# ROOTS_WATCH_URL=https://www.roots.com/ca/en/roots-x-big-apple-t-shirt-27190104.html?dwvar_27190104_color=12B
# ROOTS_WATCH_SIZES=3,5
# ROOTS_WATCH_INTERVAL=30
# ROOTS_WATCH_RENOTIFY_HOURS=6

# --- HTML dashboard (npm run ui) --------------------------------------------
# ROOTS_WATCH_UI_PORT=4321
# ROOTS_WATCH_NO_OPEN=1
